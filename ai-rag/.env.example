# Put the real key in ai-rag/.env (which must remain uncommitted).
GEMINI_API_KEY= 
OPENAI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_RETRY_DELAY_SECONDS=0.5
MEMBER_A_BASE_URL=http://127.0.0.1:8000
# "hash" is deterministic/local for development. Set a real provider before production.
EMBEDDING_PROVIDER=hash
CHROMA_PATH=./.chroma
SOURCE_REGISTRY_PATH=./.source_registry.sqlite3
