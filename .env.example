# NextStep AI - Environment Variables
# Copy this file to .env and fill in real values

# ── AI / RAG ─────────────────────────────────────────────────────────────────
# Get your free key at https://aistudio.google.com/app/apikey
# Leave empty to run in hash-embedding fallback mode (no AI enrichment)
GEMINI_API_KEY=

# Gemini model to use (default: gemini-2.0-flash)
LLM_MODEL=gemini-2.0-flash

# ── Paths (relative to repo root; change only in Docker if needed) ──────────
# Where ChromaDB stores its vector data
CHROMA_PATH=./data/chroma

# Where the RAG source-version registry is stored
SOURCE_REGISTRY_PATH=./data/source_registry.sqlite3

# ── Internal routing (unified container only) ──────────────────────────────
# The RAG service calls the matching engine internally.
# In the unified container this should stay as-is.
MEMBER_A_BASE_URL=http://127.0.0.1:8000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for open access during dev.
# In production set this to your actual domain, e.g. https://nextstepai.onrender.com
CORS_ORIGINS=*

# ── General ──────────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── Timeouts ─────────────────────────────────────────────────────────────────
GEMINI_TIMEOUT_SECONDS=30
GEMINI_RETRY_DELAY_SECONDS=0.5
